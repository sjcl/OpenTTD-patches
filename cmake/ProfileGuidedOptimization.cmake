# Clang IR instrumentation PGO. Windows defaults to the shared trained profile.
include(WindowsLLVMVersion)
include(ClangCLRuntime)
set(default_pgo OFF)
set(default_profile "")
set(default_portable_names OFF)
if(WIN32 AND CMAKE_CXX_COMPILER_ID STREQUAL "Clang" AND CMAKE_CXX_COMPILER_FRONTEND_VARIANT STREQUAL "MSVC")
    set(default_pgo USE)
    set(default_profile "${CMAKE_SOURCE_DIR}/cmake/pgo/windows.profdata")
    set(default_portable_names ON)
endif()
set(OPTION_PGO "${default_pgo}" CACHE STRING "Clang Release PGO mode: OFF, GENERATE, or USE")
set_property(CACHE OPTION_PGO PROPERTY STRINGS OFF GENERATE USE)
set(PGO_PROFILE_FILE "${default_profile}" CACHE FILEPATH "Indexed LLVM profile (.profdata) for OPTION_PGO=USE")
option(PGO_PORTABLE_NAMES "Key local PGO functions by source basename instead of absolute path" ${default_portable_names})

function(configure_pgo)
    string(TOUPPER "${OPTION_PGO}" mode)
    if(mode STREQUAL "GENERATE")
        configure_clang_cl_runtime(TRUE)
    else()
        configure_clang_cl_runtime(FALSE)
    endif()
    if(mode STREQUAL "OFF")
        return()
    endif()
    if(NOT mode STREQUAL "GENERATE" AND NOT mode STREQUAL "USE")
        message(FATAL_ERROR "OPTION_PGO must be OFF, GENERATE, or USE")
    endif()
    if(NOT CMAKE_CXX_COMPILER_ID STREQUAL "Clang")
        message(FATAL_ERROR "OPTION_PGO requires Clang and a matching llvm-profdata")
    endif()

    if(mode STREQUAL "GENERATE")
        set(profile_flag "-fprofile-generate")
    else()
        get_filename_component(profile "${PGO_PROFILE_FILE}" ABSOLUTE BASE_DIR "${CMAKE_SOURCE_DIR}")
        if(profile STREQUAL "${CMAKE_SOURCE_DIR}/cmake/pgo/windows.profdata" AND
                NOT CMAKE_CXX_COMPILER_VERSION VERSION_EQUAL OPENTTD_WINDOWS_LLVM_VERSION)
            message(FATAL_ERROR "The bundled Windows PGO profile requires LLVM ${OPENTTD_WINDOWS_LLVM_VERSION}; install that version or use OPTION_PGO=OFF / a matching custom PGO_PROFILE_FILE")
        endif()
        if(profile STREQUAL "${CMAKE_SOURCE_DIR}/cmake/pgo/windows.profdata" AND NOT PGO_PORTABLE_NAMES)
            message(FATAL_ERROR "The bundled profile requires PGO_PORTABLE_NAMES=ON")
        endif()
        if(NOT PGO_PROFILE_FILE OR NOT EXISTS "${profile}" OR IS_DIRECTORY "${profile}")
            message(FATAL_ERROR "OPTION_PGO=USE requires an existing PGO_PROFILE_FILE (.profdata)")
        endif()
        # A new profile at the same user path must invalidate existing objects too.
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${profile}")
        file(SHA256 "${profile}" profile_hash)
        file(MAKE_DIRECTORY "${CMAKE_BINARY_DIR}/pgo")
        set(snapshot "${CMAKE_BINARY_DIR}/pgo/${profile_hash}.profdata")
        configure_file("${profile}" "${snapshot}" COPYONLY)
        set(profile_flag "-fprofile-use=${snapshot}")
        message(STATUS "PGO profile SHA-256: ${profile_hash}")
    endif()

    set(targets ${OPENTTD_LIB} openttd)
    if(TARGET openttd_test)
        list(APPEND targets openttd_test)
    endif()
    list(REMOVE_DUPLICATES targets)
    foreach(target IN LISTS targets)
        target_compile_options(${target} PRIVATE "$<$<CONFIG:Release>:${profile_flag}>")
        if(PGO_PORTABLE_NAMES)
            target_compile_options(${target} PRIVATE "$<$<CONFIG:Release>:-mllvm=-static-func-full-module-prefix=false>")
            # MSVC ABI anonymous-namespace identifiers hash the main filename.
            # Normalize that too; basename-only IR names alone are insufficient.
            target_compile_options(${target} PRIVATE "$<$<CONFIG:Release>:-fmacro-prefix-map=${CMAKE_SOURCE_DIR}=/openttd>")
            file(TO_NATIVE_PATH "${CMAKE_SOURCE_DIR}" native_profile_root)
            if(NOT native_profile_root STREQUAL CMAKE_SOURCE_DIR)
                target_compile_options(${target} PRIVATE "$<$<CONFIG:Release>:-fmacro-prefix-map=${native_profile_root}=/openttd>")
            endif()
        endif()
        if(mode STREQUAL "GENERATE")
            # Background workers execute the same functions concurrently.
            target_compile_options(${target} PRIVATE "$<$<CONFIG:Release>:-fprofile-update=atomic>")
        endif()
    endforeach()

    set(executables openttd)
    if(TARGET openttd_test)
        list(APPEND executables openttd_test)
    endif()
    foreach(target IN LISTS executables)
        if(NOT CMAKE_CXX_COMPILER_FRONTEND_VARIANT STREQUAL "MSVC")
            target_link_options(${target} PRIVATE "$<$<CONFIG:Release>:${profile_flag}>")
        endif()
    endforeach()
    message(STATUS "Clang PGO ${mode} enabled for Release")
endfunction()
