# Clang IR instrumentation PGO. Keep the default build unchanged.
set(OPTION_PGO "OFF" CACHE STRING "Clang Release PGO mode: OFF, GENERATE, or USE")
set_property(CACHE OPTION_PGO PROPERTY STRINGS OFF GENERATE USE)
set(PGO_PROFILE_FILE "" CACHE FILEPATH "Indexed LLVM profile (.profdata) for OPTION_PGO=USE")

function(configure_pgo)
    string(TOUPPER "${OPTION_PGO}" mode)
    if(mode STREQUAL "OFF")
        return()
    endif()
    if(NOT mode STREQUAL "GENERATE" AND NOT mode STREQUAL "USE")
        message(FATAL_ERROR "OPTION_PGO must be OFF, GENERATE, or USE")
    endif()
    if(NOT CMAKE_CXX_COMPILER_ID STREQUAL "Clang")
        message(FATAL_ERROR "OPTION_PGO requires Clang and a matching llvm-profdata")
    endif()

    if(mode STREQUAL "GENERATE")
        set(profile_flag "-fprofile-generate")
    else()
        get_filename_component(profile "${PGO_PROFILE_FILE}" ABSOLUTE BASE_DIR "${CMAKE_SOURCE_DIR}")
        if(NOT PGO_PROFILE_FILE OR NOT EXISTS "${profile}" OR IS_DIRECTORY "${profile}")
            message(FATAL_ERROR "OPTION_PGO=USE requires an existing PGO_PROFILE_FILE (.profdata)")
        endif()
        # A new profile at the same user path must invalidate existing objects too.
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${profile}")
        file(SHA256 "${profile}" profile_hash)
        file(MAKE_DIRECTORY "${CMAKE_BINARY_DIR}/pgo")
        set(snapshot "${CMAKE_BINARY_DIR}/pgo/${profile_hash}.profdata")
        configure_file("${profile}" "${snapshot}" COPYONLY)
        set(profile_flag "-fprofile-use=${snapshot}")
        message(STATUS "PGO profile SHA-256: ${profile_hash}")
    endif()

    set(targets ${OPENTTD_LIB} openttd)
    if(TARGET openttd_test)
        list(APPEND targets openttd_test)
    endif()
    list(REMOVE_DUPLICATES targets)
    foreach(target IN LISTS targets)
        target_compile_options(${target} PRIVATE "$<$<CONFIG:Release>:${profile_flag}>")
        if(mode STREQUAL "GENERATE")
            # Background workers execute the same functions concurrently.
            target_compile_options(${target} PRIVATE "$<$<CONFIG:Release>:-fprofile-update=atomic>")
        endif()
    endforeach()

    set(executables openttd)
    if(TARGET openttd_test)
        list(APPEND executables openttd_test)
    endif()
    foreach(target IN LISTS executables)
        if(CMAKE_CXX_COMPILER_FRONTEND_VARIANT STREQUAL "MSVC")
            if(mode STREQUAL "GENERATE")
                # clang-cl embeds the profile runtime's default-library directive;
                # MSBuild invokes lld-link directly, so supply its search path.
                execute_process(COMMAND "${CMAKE_CXX_COMPILER}" -print-resource-dir
                    RESULT_VARIABLE result OUTPUT_VARIABLE resource_dir
                    OUTPUT_STRIP_TRAILING_WHITESPACE)
                if(NOT result EQUAL 0 OR NOT IS_DIRECTORY "${resource_dir}/lib/windows")
                    message(FATAL_ERROR "Cannot locate the clang-cl profile runtime")
                endif()
                target_link_directories(${target} PRIVATE "$<$<CONFIG:Release>:${resource_dir}/lib/windows>")
            endif()
        else()
            target_link_options(${target} PRIVATE "$<$<CONFIG:Release>:${profile_flag}>")
        endif()
    endforeach()
    message(STATUS "Clang PGO ${mode} enabled for Release")
endfunction()
