function(configure_clang_cl_runtime with_profile)
    if(NOT CMAKE_CXX_COMPILER_ID STREQUAL "Clang" OR NOT CMAKE_CXX_COMPILER_FRONTEND_VARIANT STREQUAL "MSVC")
        return()
    endif()
    execute_process(COMMAND "${CMAKE_CXX_COMPILER}" -print-resource-dir
        RESULT_VARIABLE result OUTPUT_VARIABLE resource_dir
        OUTPUT_STRIP_TRAILING_WHITESPACE)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Cannot locate the clang-cl runtime")
    endif()
    if(CMAKE_CXX_COMPILER_ARCHITECTURE_ID STREQUAL "ARM64" OR CMAKE_CXX_COMPILER_TARGET MATCHES "aarch64|arm64")
        set(runtime_arch aarch64)
    elseif(CMAKE_SIZEOF_VOID_P EQUAL 4)
        set(runtime_arch i386)
    else()
        set(runtime_arch x86_64)
    endif()
    set(runtime_dir "${resource_dir}/lib/${runtime_arch}-pc-windows-msvc")
    if(EXISTS "${resource_dir}/lib/windows/clang_rt.profile-${runtime_arch}.lib" OR NOT IS_DIRECTORY "${runtime_dir}")
        set(runtime_dir "${resource_dir}/lib/windows")
    endif()
    set(executables openttd)
    if(TARGET openttd_test)
        list(APPEND executables openttd_test)
    endif()
    foreach(target IN LISTS executables)
        # LLD needs compiler-rt's implementations of 128-bit integer helpers.
        # Supply this even when the user explicitly disables PGO.
        if(EXISTS "${runtime_dir}/clang_rt.builtins-${runtime_arch}.lib")
            target_link_options(${target} PRIVATE "/DEFAULTLIB:${runtime_dir}/clang_rt.builtins-${runtime_arch}.lib")
        elseif(EXISTS "${runtime_dir}/clang_rt.builtins.lib")
            target_link_options(${target} PRIVATE "/DEFAULTLIB:${runtime_dir}/clang_rt.builtins.lib")
        endif()
        if(with_profile)
            if(NOT IS_DIRECTORY "${runtime_dir}")
                message(FATAL_ERROR "Cannot locate the clang-cl profile runtime")
            endif()
            # clang-cl embeds a default-library directive for this runtime.
            target_link_directories(${target} PRIVATE "$<$<CONFIG:Release>:${runtime_dir}>")
        endif()
    endforeach()
endfunction()
