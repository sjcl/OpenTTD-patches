cmake_minimum_required(VERSION 3.17)
# Real PATX save/load and legacy migration, including a conflicting local config.
file(MAKE_DIRECTORY "${WORK_DIR}/scripts")
if(EDITBIN_EXECUTABLE)
    set(console_binary "${WORK_DIR}/passenger_rounds_test.exe")
    execute_process(COMMAND "${CMAKE_COMMAND}" -E copy "${OPENTTD_EXECUTABLE}" "${console_binary}" COMMAND_ERROR_IS_FATAL ANY)
    execute_process(COMMAND "${EDITBIN_EXECUTABLE}" /nologo /subsystem:console "${console_binary}" COMMAND_ERROR_IS_FATAL ANY)
    set(OPENTTD_EXECUTABLE "${console_binary}")
endif()
set(setting "linkgraph.passenger_timed_rounds")
function(check stage input config expected commands)
    file(WRITE "${WORK_DIR}/openttd.cfg" "[misc]\nlanguage = english.lng\n[gui]\nautosave = off\nautosave_on_exit = false\nthreaded_saves = false\n[linkgraph]\npassenger_timed_rounds = ${config}\n")
    file(WRITE "${WORK_DIR}/scripts/game_start.scr" "script \"${WORK_DIR}/${stage}.log\"\nsetting ${setting}\n${commands}\nquit\n")
    execute_process(COMMAND "${OPENTTD_EXECUTABLE}" -x -Q -c "${WORK_DIR}/openttd.cfg" -g "${input}" -vnull:ticks=10 -snull -mnull
        WORKING_DIRECTORY "${WORK_DIR}" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 20)
    file(WRITE "${WORK_DIR}/${stage}-process.log" "${output}\n${error}")
    file(READ "${WORK_DIR}/${stage}.log" log)
    if(NOT result EQUAL 0 OR NOT log MATCHES "Current value for '${setting}' is: '${expected}'")
        message(FATAL_ERROR "${stage}: rounds setting migration/persistence failed: ${result} ${log} ${error}")
    endif()
endfunction()
check(legacy "${LEGACY_SAVE}" true false "setting ${setting} true\nsave \"${WORK_DIR}/enabled\"")
check(enabled "${WORK_DIR}/enabled.sav" false true "save \"${WORK_DIR}/plain\"")
check(compare "${WORK_DIR}/enabled.sav" false true "passenger_timed_compare 16\npassenger_journey_stats reset\nsave \"${WORK_DIR}/compared\"")
file(SHA256 "${WORK_DIR}/plain.sav" plain)
file(SHA256 "${WORK_DIR}/compared.sav" compared)
if(NOT plain STREQUAL compared)
    message(FATAL_ERROR "Read-only timed comparison altered saved simulation state")
endif()
check(disable "${WORK_DIR}/enabled.sav" false true "setting ${setting} false\nsave \"${WORK_DIR}/disabled\"")
check(disabled "${WORK_DIR}/disabled.sav" true false "")
message(STATUS "Round selection legacy migration, saved setting, and diagnostic purity passed")
