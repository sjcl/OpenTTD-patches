# Compiler selection must happen before project(). Explicit toolchains win.
if(NOT CMAKE_HOST_WIN32)
    return()
endif()
if(CMAKE_GENERATOR MATCHES "Visual Studio")
    if(NOT CMAKE_GENERATOR_TOOLSET AND NOT DEFINED CMAKE_CXX_COMPILER AND "$ENV{CXX}" STREQUAL "")
        # CMake has already created an empty INTERNAL cache entry here.
        set(CMAKE_GENERATOR_TOOLSET "ClangCL" CACHE STRING "Windows compiler toolset" FORCE)
    endif()
    if(CMAKE_GENERATOR_TOOLSET MATCHES "^ClangCL(,|$)" AND EXISTS "$ENV{ProgramFiles}/LLVM/bin/clang-cl.exe" AND
            NOT "${CMAKE_VS_GLOBALS}" MATCHES "(^|;)LLVMInstallDir=")
        include("${CMAKE_CURRENT_LIST_DIR}/WindowsLLVMVersion.cmake")
        list(APPEND CMAKE_VS_GLOBALS "LLVMInstallDir=$ENV{ProgramFiles}/LLVM/")
        if(NOT "${CMAKE_VS_GLOBALS}" MATCHES "(^|;)LLVMToolsVersion=")
            list(APPEND CMAKE_VS_GLOBALS "LLVMToolsVersion=${OPENTTD_WINDOWS_LLVM_VERSION}")
        endif()
    endif()
elseif(CMAKE_GENERATOR MATCHES "Ninja|NMake" AND NOT DEFINED CMAKE_CXX_COMPILER AND "$ENV{CXX}" STREQUAL "" AND
        (NOT CMAKE_TOOLCHAIN_FILE OR CMAKE_TOOLCHAIN_FILE MATCHES "vcpkg.cmake$"))
    find_program(OPENTTD_CLANG_CL NAMES clang-cl HINTS "$ENV{ProgramFiles}/LLVM/bin" NO_DEFAULT_PATH)
    if(NOT OPENTTD_CLANG_CL)
        find_program(OPENTTD_CLANG_CL NAMES clang-cl REQUIRED)
    endif()
    set(CMAKE_CXX_COMPILER "${OPENTTD_CLANG_CL}" CACHE FILEPATH "Windows C++ compiler")
    get_filename_component(llvm_bin "${OPENTTD_CLANG_CL}" DIRECTORY)
    if(NOT DEFINED CMAKE_LINKER)
        set(CMAKE_LINKER "${llvm_bin}/lld-link.exe" CACHE FILEPATH "Windows LLVM linker")
    endif()
    if(NOT DEFINED CMAKE_C_COMPILER AND "$ENV{CC}" STREQUAL "")
        set(CMAKE_C_COMPILER "${OPENTTD_CLANG_CL}" CACHE FILEPATH "Windows C compiler")
    endif()
endif()
if(NOT CMAKE_BUILD_TYPE AND NOT CMAKE_GENERATOR MATCHES "Visual Studio|Multi-Config")
    set(CMAKE_BUILD_TYPE Release CACHE STRING "Build configuration")
endif()
if(NOT CMAKE_BUILD_TYPE STREQUAL "Debug")
    set(OPTION_USE_ASSERTS OFF CACHE BOOL "Use assertions; enable for debugging")
endif()
