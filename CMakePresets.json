{
  "version": 3,
  "configurePresets": [
    {
      "name": "windows-release",
      "displayName": "Windows Clang + LLVM ThinLTO + shared PGO",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "clang-cl",
        "CMAKE_CXX_COMPILER": "clang-cl",
        "CMAKE_LINKER": "lld-link",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows-static",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded",
        "CMAKE_C_FLAGS_RELEASE": "/O2 /Ob2 /DNDEBUG /Z7",
        "CMAKE_CXX_FLAGS_RELEASE": "/O2 /Ob2 /DNDEBUG /Z7",
        "CMAKE_EXE_LINKER_FLAGS": "/DEBUG:FULL /OPT:REF /OPT:ICF /INCREMENTAL:NO",
        "OPTION_USE_ASSERTS": "OFF",
        "OPTION_NO_LTO": "OFF",
        "OPTION_PGO": "USE"
      }
    }
  ],
  "buildPresets": [ { "name": "windows-release", "configurePreset": "windows-release", "targets": ["openttd"] } ]
}
