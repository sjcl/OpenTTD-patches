if(NOT CMAKE_CURRENT_SOURCE_DIR STREQUAL CMAKE_SOURCE_DIR)
  return()
endif()
function(add_passenger_row_debug_check)
  add_library(passenger_row_debug OBJECT "${PROJECT_SOURCE_DIR}/src/passenger_precomputed.cpp")
  get_target_property(row_check_includes openttd_lib INCLUDE_DIRECTORIES)
  get_target_property(row_check_definitions openttd_lib COMPILE_DEFINITIONS)
  target_include_directories(passenger_row_debug PRIVATE ${row_check_includes} "${CMAKE_PREFIX_PATH}/include")
  if(row_check_definitions)
    target_compile_definitions(passenger_row_debug PRIVATE ${row_check_definitions})
  endif()
  target_compile_definitions(passenger_row_debug PRIVATE _DEBUG _ITERATOR_DEBUG_LEVEL=2 WITH_ASSERT)
  target_compile_features(passenger_row_debug PRIVATE cxx_std_23)
  set_target_properties(passenger_row_debug PROPERTIES MSVC_RUNTIME_LIBRARY MultiThreadedDebug)
endfunction()
cmake_language(DEFER CALL add_passenger_row_debug_check)
